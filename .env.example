# Corpus root (the folder that contains manifest.jsonl). Only needed for `npm run ingest`.
CORPUS_DIR=C:/path/to/Kalvora_HR_Policies

# ---- Models -------------------------------------------------------------------------------
# Default: LM Studio on this machine (OpenAI-compatible server).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Only needed if "Require API key" is on in LM Studio's server settings
LMSTUDIO_API_KEY=lm-studio

# Any other OpenAI-compatible provider overrides LM Studio. Free option (Google Gemini API,
# key from https://aistudio.google.com/apikey); run `npm run models` to see the model ids:
#   CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   CHAT_API_KEY=<gemini key>
#   CHAT_MODEL=<a Flash model id from npm run models>
#   EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   EMBED_API_KEY=<gemini key>
#   EMBED_MODEL=gemini-embedding-001
#   EMBED_DIMENSIONS=768
#   EMBED_DELAY_MS=1000
#   DOC_PREFIX=""
#   QUERY_PREFIX=""
CHAT_BASE_URL=
CHAT_API_KEY=
# Chat model (empty = with LM Studio, auto-pick the first loaded non-embedding model; required otherwise)
CHAT_MODEL=
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# Shorter vectors from providers that support it (Gemini: 768). Empty = model default.
EMBED_DIMENSIONS=
# Pause between embedding batches during ingestion, for free-tier rate limits
EMBED_DELAY_MS=0
# nomic-embed needs task prefixes; set both to "" for models that don't (Gemini, bge, gte, MiniLM)
DOC_PREFIX="search_document: "
QUERY_PREFIX="search_query: "
# Chunks retrieved per question
TOP_K=6

# ---- Vector store -------------------------------------------------------------------------
# supabase = Supabase Postgres + pgvector (what the deployed app uses; schema in supabase/migrations)
# chroma   = Chroma server (npm run chroma)
# file     = the index in INDEX_DIR, searched in memory (no database)
# Default: supabase on Vercel, chroma elsewhere.
VECTOR_STORE=chroma
# Supabase project (kalvora-hr) and its server-only secret key (sb_secret_..., from
# Project Settings > API Keys). The secret key bypasses RLS: keep it out of the repo and the UI.
SUPABASE_URL=https://txkivrtpuiqphwvdanei.supabase.co
SUPABASE_SECRET_KEY=
INDEX_DIR=data/index
CHROMA_URL=http://localhost:8000
COLLECTION=kalvora_hr
BATCH_SIZE=64

# Google sign-in for the web UI (npm run server). Leave GOOGLE_CLIENT_ID empty to turn sign-in
# off for local development; it is required when deployed (VERCEL / NODE_ENV=production).
# Create an OAuth "Web application" client at https://console.cloud.google.com/apis/credentials
# and add http://localhost, http://localhost:5173 and http://localhost:3001 as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
# Signs the session cookie. At least 32 chars: openssl rand -hex 32
SESSION_SECRET=
# Optional allowlists (comma-separated). Both empty = any verified Google account may sign in.
ALLOWED_DOMAINS=
ALLOWED_EMAILS=
# Session length in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168
