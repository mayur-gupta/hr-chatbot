# Corpus root (the folder that contains manifest.jsonl)
CORPUS_DIR=C:/path/to/Kalvora_HR_Policies

# LM Studio OpenAI-compatible server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Only needed if "Require API key" is on in LM Studio's server settings
LMSTUDIO_API_KEY=lm-studio
# Chat model for `npm run ask` (leave empty to auto-pick the first loaded non-embedding model)
CHAT_MODEL=
# Chunks retrieved per question
TOP_K=6
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
# nomic-embed needs task prefixes; set both to "" for models that don't (bge, gte, MiniLM)
DOC_PREFIX="search_document: "
QUERY_PREFIX="search_query: "

# Chroma server (start it with: npm run chroma)
CHROMA_URL=http://localhost:8000
COLLECTION=kalvora_hr
BATCH_SIZE=64
